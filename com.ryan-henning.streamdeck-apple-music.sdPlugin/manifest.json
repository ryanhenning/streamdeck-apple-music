{
	"Name": "Playlists for Apple Music",
	"Version": "0.1.0.0",
	"Author": "Ryan Henning",
	"Actions": [
		{
			"Name": "Browse Playlists",
			"UUID": "com.ryan-henning.streamdeck-apple-music.playlist-dial",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Rotate to browse playlists; push to play, tap to shuffle.",
			"PropertyInspectorPath": "ui/apple-music-settings.html",
			"Controllers": [
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key"
				}
			],
			"Encoder": {
				"layout": "layouts/apple-music-dial.json",
				"TriggerDescription": {
					"Rotate": "Browse playlists",
					"Push": "Play playlist in order",
					"Touch": "Tap: shuffle playlist · Hold: reload"
				}
			}
		},
		{
			"Name": "Favorite Track",
			"UUID": "com.ryan-henning.streamdeck-apple-music.favorite",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Favorites the song playing in Apple Music.",
			"PropertyInspectorPath": "ui/apple-music-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"Title": "♥ Favorite",
					"TitleAlignment": "middle"
				}
			]
		}
	],
	"Category": "Playlists for Apple Music",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Browse your Apple Music playlists on a Stream Deck+ dial, with their cover art, and play them in order or shuffled. Windows only; needs the Apple Music app from the Microsoft Store. Not affiliated with or endorsed by Apple.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.ryan-henning.streamdeck-apple-music"
}
